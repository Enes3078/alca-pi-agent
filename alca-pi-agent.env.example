# CRM adresi. BILEREK BOS: kurulum sihirbazi adresi yazdirmadan gecmez.
# Ornek: https://crm.firmaniz.com
ALCA_CRM_URL=

# Create this token from CRM > İmalat Yönetimi > Cihaz & Veri.
ALCA_DEVICE_TOKEN=PASTE_DEVICE_TOKEN_HERE

# Raspberry Pi fiziksel pin 13 = BCM GPIO27 (kurulum sihirbazinin onerdigi baglanti).
# Fiziksel pin 11 kullanilirsa BCM GPIO17 yazilir.
ALCA_GPIO_BCM=27
# false: Pi'nin ic pull-down direnci (cok zayif). Uzun kabloda ve gerilimsiz
# kontakta tek basina yetmez; README "Kablolama kontrol listesi" 3. madde.
ALCA_PULL_UP=false
ALCA_POLL_INTERVAL_SECONDS=0.002
# ALCA_BOUNCE_SECONDS artik okunmuyor: Temmuz 2026'dan (391b844) beri kullanilmiyor;
# daha eski ajanda gpiozero Button bounce_time idi. Eski dosyalarda kalmissa zarari
# yok, silinebilir. Suzgec ALCA_PULSE_* ayarlaridir.

# pulse: her tam sinyal cevrimi (bos -> aktif -> bos) 1 adet sayilir.
# duration: high voltage duration is measured and sent as seconds/minutes.
ALCA_MEASUREMENT_MODE=pulse
# rising: bosta 0, vurusta 1. falling: bosta 1, vurusta 0.
# both: eski ayar, rising ile AYNI calisir (tam cevrimi 1 sayar; her degisimi
# ayri SAYMAZ). Yeni kurulumda rising ya da falling yazin.
ALCA_PULSE_EDGE=rising
# Bir vurus yalniz tam ve kararli bir bos -> aktif -> bos cevrimi bitince sayilir.
#   MIN_ACTIVE  : aktif en az bu kadar surmeli (kisa parazit sayilmaz).
#   REARM       : vurustan once ve sonra en az bu kadar bos kalmali.
#   MAX_ACTIVE  : bundan uzun aktif (takili sinyal) sayilmaz.
#   MIN_INTERVAL: iki vurus arasi en az; makinenin en kisa GERCEK cevriminin
#                 yarisi onerilir.
# Degerler makine turune gore degil OLCULEREK secilir: diagnose_gpio.py olcer
# ve oneri yazar; install.sh en kisa cevrimi sorar (README "Ayari olcerek bulmak").
ALCA_PULSE_MIN_ACTIVE_SECONDS=0.02
ALCA_PULSE_REARM_SECONDS=0.20
ALCA_PULSE_MAX_ACTIVE_SECONDS=10.0
ALCA_PULSE_MIN_INTERVAL_SECONDS=0.20
ALCA_DURATION_UNIT=seconds
ALCA_MIN_DURATION_SECONDS=0.2
ALCA_DURATION_ACTIVE_LEVEL=high
ALCA_DURATION_START_STABLE_SECONDS=0.20
ALCA_DURATION_STOP_STABLE_SECONDS=0.20
# Ignore short LOW gaps while a duration machine is running. A real stop must
# remain LOW continuously for this many seconds.
ALCA_DURATION_DROPOUT_GRACE_SECONDS=1.50
# Aggregate ignored dropout diagnostics instead of writing one log per glitch.
ALCA_DURATION_DROPOUT_LOG_INTERVAL_SECONDS=30
ALCA_DAILY_RESET=true

# Optional. Leave empty if the tablet has an active session and only one active work line at this station.
# If multiple active jobs exist on the station, set ALCA_LINE_ID from the work order line id or map it in CRM.
ALCA_LINE_ID=
ALCA_STATION_CODE=
ALCA_OPERATOR_ID=

ALCA_NOTE=GPIO27 physical pin 13 pulse
ALCA_HTTP_TIMEOUT=5
# Kuyruk dosyasi. Yaninda ".lock" kilit dosyasi durur: ayni anda tek ajan calisir.
ALCA_QUEUE_DB=/var/lib/alca-pi-agent/machine_events.sqlite3

# Gonderilemeyen kayit icin bekleme. Kayit kuyrukta ertelenir, arkasindakiler
# beklemeden gonderilir. Gecici hatada 5 sn'den baslayip katlanir; sunucu
# "gecersiz kayit" derse (400/403/404/409/422) 60 sn'den baslar; ust sinir 300 sn.
ALCA_SEND_RETRY_BASE_SECONDS=5
ALCA_SEND_RETRY_VALIDATION_SECONDS=60
ALCA_SEND_RETRY_MAX_SECONDS=300
